# Google AI Studio
GOOGLE_AI_API_KEY=
AI_MODEL=

# RSSHub instance
RSSHUB_BASE_URL=

# Cron schedule: noon & midnight
CRON_SCHEDULE=0 0,12 * * *

# Twitter service (internal docker network)
TWITTER_SERVICE_URL=
TWITTER_BEARER_TOKEN=
TWITTER_CONSUMER_TOKEN=
TWITTER_CONSUMER_SECRET=

