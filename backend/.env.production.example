# PostgreSQL — Supabase pooled connection string
# Supabase Dashboard > Project Settings > Database > Connection string > URI (use pooler port 6543)
DATABASE_URL=

# Server
PORT=3009
NODE_ENV=production

# Internal API secret (FE proxy gửi header X-Api-Key)
API_SECRET_KEY=

# Auth
JWT_SECRET=
